@startuml
skinparam classAttributeIconSize 0

package "DAL" {
	' Repositories
	class CampRepository <<Repository>> {
		+findAll() : List<Camp>
		+findById(int) : Camp
		+save(Camp) : Camp
		+delete(int)
		+commit()
		+rollback()
	}

	class UserRepository <<Repository>> {
		+findByEmail(String email) : User
		+findAll() : List<User>
		+findById(int) : User
		+save(User) : User
		+delete(int id)
		+commit()
		+rollback()
	}
	CampRepository -[hidden]right-> UserRepository

	class ParticipantRepository <<Repository>> {
		+findAllByUser(User) : List<Participant>
		+findAllByCamp(Camp) : List<Participant>
		+findAllByPerson(Person) : List<Participant>
		+findById(int) : Participant
		+getDefaultRole() : Role
		+save(Participant) : Participant
		+delete(int)
		+commit()
		+rollback()
	}
	UserRepository -[hidden]right-> ParticipantRepository

	class PersonRepository <<Repository>> {
		+findAll() : List<Person>
		+findById(int) : Person
		+findByPersonalNumber(String) : Person
		+findAllByUser(User) : List<Person>
		+save(Person entity) : Person
		+delete(int)
		+commit()
		+rollback()
	}
	ParticipantRepository -[hidden]right-> PersonRepository

	class TaskRepository <<Repository>> {
		+findAll() : List<Task>
		+findAllByCampId(Camp) : List<Task>
		+findById(int) : Task
		+save(Task entity) : Task
		+delete(int id)
		+commit()
		+rollback()
	}
	PersonRepository -[hidden]right-> TaskRepository
}

package "DAL.sql" {
	' Gateways
	class CampGateway <<TableDataGateway>> {
		-jdbcTemplate : JdbcTemplate
		+findAll() : List<CampRecord>
		+findById(int) : CampRecord
		+save(CampRecord) : int
		+delete(int) : int
	}

	class UserGateway <<TableDataGateway>> {
		-jdbcTemplate : JdbcTemplate
		+findAll() : List<UserRecord>
		+findById(int) : UserRecord
		+findByEmail(String) : UserRecord
		+save(UserRecord) : int
		+delete(int) : int
	}
	CampGateway -[hidden]right-> UserGateway

	class RoleGateway <<TableDataGateway>> {
		-jdbcTemplate : JdbcTemplate
		+findAll() : List<RoleRecord>
		+findById(int) : RoleRecord
		+save(RoleRecord) : int
		+delete(int) : int
	}
	UserGateway -[hidden]right-> RoleGateway

	class ParticipantGateway <<TableDataGateway>> {
		-jdbcTemplate : JdbcTemplate
		+findAll() : List<ParticipantRecord>
		+findAllByUserId(int) : List<ParticipantRecord>
		+findAllByCampId(int) : List<ParticipantRecord>
		+findAllByPersonId(int) : List<ParticipantRecord>
		+findById(int) : ParticipantRecord
		+save(ParticipantRecord) : int
		+delete(int) : int
	}
	RoleGateway -[hidden]right-> ParticipantGateway

	class DrugGateway <<TableDataGateway>> {
		-jdbcTemplate : JdbcTemplate
		+findAll() : List<DrugRecord>
		+findAllByPersonId(int) : List<DrugRecord>
		+findById(int) : DrugRecord
		+findPersonById(int) : Integer
		+save(DrugRecord) : int
		+delete(int) : int
	}
	ParticipantGateway -[hidden]right-> DrugGateway

	class PersonGateway <<TableDataGateway>> {
		-jdbcTemplate : JdbcTemplate
		+findAll() : List<PersonRecord>
		+findAllByUserId(int) : List<PersonRecord>
		+findById(int) : PersonRecord
		+findByPersonalNumber(String) : PersonRecord
		+save(PersonRecord) : int
		+delete(int) : int
	}
	DrugGateway -[hidden]right-> PersonGateway

	class ParticipantTaskGateway <<TableDataGateway>> {
		-jdbcTemplate : JdbcTemplate
		+findAll() : List<ParticipantTaskRecord>
		+findAllByTaskId(int) : List<ParticipantTaskRecord>
		+findById(int) : ParticipantTaskRecord
		+save(ParticipantTaskRecord) : int
		+delete(int) : int
		+deleteByTaskIdAndParticipantId(int, int) : int
	}
	PersonGateway -[hidden]right-> ParticipantTaskGateway
}

package "DAL.xml" {
	class TaskGateway <<TableDataGateway>> {
		-xmlMapper : XmlMapper
		-path : Path
		+findAll() : List<TaskRecord>
		+findById(int) : TaskRecord
		+save(TaskRecord) : int
		+delete(int) : int
	}
}

CampRepository ..down.> CampGateway : <<uses>>
UserRepository ..down.> UserGateway : <<uses>>

ParticipantRepository ..down.> ParticipantGateway : <<uses>>
ParticipantRepository ..down.> RoleGateway : <<uses>>

PersonRepository ..down.> ParticipantGateway : <<uses>>
PersonRepository ..down.> PersonGateway : <<uses>>
PersonRepository ..down.> DrugGateway : <<uses>>

TaskRepository .down.> TaskGateway : <<uses>>
TaskRepository .down.> ParticipantTaskGateway : <<uses>>
TaskRepository .down.> ParticipantGateway : <<uses>>


package "DAL" {
	' Records
	class UserRecord <<Record>> {
		+id : Integer
		+name : String
		+email : String
		+password : String
	}
	UserGateway ..up.> UserRecord
	UserRecord <..up. UserRepository

	class RoleRecord <<Record>> {
		+id : Integer
		+name : String
		+canEditCamp : Boolean
		+canCreateTask : Boolean
		+canEditTask : Boolean
		+canViewDrugs : Boolean
		+canReceiveInfo : Boolean
	}
	RoleGateway ..up.> RoleRecord
	RoleRecord <..up. ParticipantRepository

	class ParticipantRecord <<Record>> {
		+id : Integer
		+campId : Integer
		+personId : Integer
		+roleId : Integer
	}
	ParticipantGateway ..up.> ParticipantRecord
	ParticipantRecord <..up. ParticipantRepository
	ParticipantRecord <..up. PersonRepository
	ParticipantRecord <..up. TaskRepository

	class DrugRecord <<Record>> {
		+id : Integer
		+personId : Integer
		+name : String
		+dosage : Integer
		+description : String
	}
	DrugGateway ..up.> DrugRecord
	DrugRecord <..up. PersonRepository

	class PersonRecord <<Record>> {
		+id : Integer
		+userId : Integer
		+personalNumber : String
		+name : String
		+town : String
		+street : String
		+postalCode : String
		+bornDate : OffsetDateTime
	}
	PersonGateway ..up.> PersonRecord
	PersonRecord <..up. PersonRepository

	class CampRecord <<Record>> {
		+id : Integer
		+name : String
		+description : String
		+imgUrl : String
		+startDate : OffsetDateTime
		+endDate : OffsetDateTime
		+price : Integer
		+capacity : Integer
		+registered : Integer
	}
	CampGateway ..up.> CampRecord
	CampRecord <..up. CampRepository

	class ParticipantTaskRecord <<Record>> {
		+participantId : Integer
		+taskId : Integer
	}
	ParticipantTaskGateway ..up.> ParticipantTaskRecord
	ParticipantTaskRecord <..up. TaskRepository

	class TaskRecord <<Record>> {
		+id : Integer
		+shortDescription : String
		+description : String
		+createdAt : OffsetDateTime
		+finishAt : OffsetDateTime
		+startDate : OffsetDateTime
		+dueDate : OffsetDateTime
	}
	TaskGateway ..up.> TaskRecord
	TaskRecord <..up. TaskRepository
}

@enduml
